class DB_Manager:
    def __init__(self, database):
        self.database = database

    def create_tables(self):
        """Создает все таблицы в нашей базе данных"""
        with sqlite3.connect(self.database) as conn:
            
            conn.execute('''CREATE TABLE IF NOT EXISTS projects (
                project_id INTEGER PRIMARY KEY,
                user_id INTEGER,
                project_name TEXT NOT NULL,
                description TEXT,
                url TEXT,
                status_id INTEGER,
                FOREIGN KEY(status_id) REFERENCES status(status_id)
            )''')
            
            conn.execute('''CREATE TABLE IF NOT EXISTS status (
                status_id INTEGER PRIMARY KEY,
                status_name TEXT NOT NULL
            )''')

            conn.execute('''CREATE TABLE IF NOT EXISTS skills (
                skill_id INTEGER PRIMARY KEY,
                skill_name TEXT NOT NULL
            )''')

            conn.execute('''CREATE TABLE IF NOT EXISTS project_skills (
                project_id INTEGER,
                skill_id INTEGER,
                FOREIGN KEY(project_id) REFERENCES projects(project_id),
                FOREIGN KEY(skill_id) REFERENCES skills(skill_id)
            )''')
            
            conn.commit()
            
        self.default_insert()

    def _executemany(self, sql, data):
        """Вспомогательный метод для массового добавления данных"""
        with sqlite3.connect(self.database) as conn:
            conn.executemany(sql, data)
            conn.commit()

    def _select_data(self, sql, data=tuple()):
        """Вспомогательный метод для получения (выбора) данных"""
        with sqlite3.connect(self.database) as conn:
            cur = conn.cursor()
            cur.execute(sql, data)
            return cur.fetchall()

    def default_insert(self):
        """Заполняет таблицы навыков и статусов начальными значениями"""
        sql_skills = 'INSERT OR IGNORE INTO skills (skill_name) VALUES(?)'
        self._executemany(sql_skills, skills)
        
        sql_statuses = 'INSERT OR IGNORE INTO status (status_name) VALUES(?)'
        self._executemany(sql_statuses, statuses)

    def insert_project(self, data):
        """Добавляет новый проект в базу данных"""
        sql = '''INSERT INTO projects (user_id, project_name, description, url, status_id) 
                 VALUES (?, ?, ?, ?, ?)'''
        self._executemany(sql, data)

    def get_statuses(self):
        """Возвращает список всех доступных статусов"""
        sql = "SELECT status_name FROM status"
        return self._select_data(sql)

    def get_status_id(self, status_name):
        """Ищет ID статуса по его названию"""
        sql = 'SELECT status_id FROM status WHERE status_name = ?'
        res = self._select_data(sql, (status_name,))
        if res:
            return res
        return None

    def get_projects(self, user_id):
        """Возвращает все проекты конкретного пользователя"""
        sql = "SELECT project_name, description, url, status_id FROM projects WHERE user_id = ?"
        return self._select_data(sql, (user_id,))

