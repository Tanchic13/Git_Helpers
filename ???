    def get_project_info(self, user_id, project_name):
        """Получает полную информацию о проекте вместе с текстовым названием его статуса"""
        sql = """SELECT project_name, description, url, status_name FROM projects 
                 JOIN status ON status.status_id = projects.status_id 
                 WHERE project_name=? AND user_id=?"""
        return self._select_data(sql, (project_name, user_id))

