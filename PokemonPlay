@bot.callback_query_handler(func=lambda call: call.data.startswith("buy_"))
def handle_shop_buy(call):
    username = call.from_user.username or call.from_user.first_name
    chat_id = call.message.chat.id

    if username not in users_data:
        bot.answer_callback_query(call.id, "Профиль не найден.")
        return

    # Защита на случай, если зашли в магазин сразу после перезапуска бота
    if 'dmg_upgrades' not in users_data[username]:
        users_data[username]['dmg_upgrades'] = 0
    if 'hp_upgrades' not in users_data[username]:
        users_data[username]['hp_upgrades'] = 0

    price_dmg = get_dmg_price(username)
    price_hp = get_hp_price(username)

    # ПОКУПКА АТАКИ
    if call.data == "buy_dmg":
        if users_data[username]["coins"] >= price_dmg:
            users_data[username]["coins"] -= price_dmg

            users_data[username]['dmg_upgrades'] += 1

            # Изменяем параметры внутри объекта покемона через точку
            users_data[username]["pokemon"].attack += 3
            users_data[username]["pokemon"].level += 0.5

            bot.send_message(chat_id, f"⚔️ Успешно! Сила клика увеличена на 3! Уровень покемона повышен до {users_data[username]['pokemon'].level}!")
        else:
            bot.send_message(chat_id, f"❌ У вас недостаточно монет для этого улучшения. Требуется: {price_dmg}")

    # ПОКУПКА ЗДОРОВЬЯ
    elif call.data == "buy_hp":
        if users_data[username]["coins"] >= price_hp:
            users_data[username]["coins"] -= price_hp

            users_data[username]['hp_upgrades'] += 1

            users_data[username]["pokemon"].max_hp += 50
            users_data[username]["pokemon"].level += 1

            bot.send_message(chat_id, f"❤️ Успешно! Максимальное здоровье увеличено на 100! Уровень покемона повышен до {users_data[username]['pokemon'].level}!")
        else:
            bot.send_message(chat_id, f"❌ У вас недостаточно монет для этого улучшения. Требуется: {price_hp}")


    try:
        next_price_dmg = get_dmg_price(username)
        next_price_hp = get_hp_price(username)

        updated_markup = types.InlineKeyboardMarkup(row_width=1)
        updated_markup.add(
            types.InlineKeyboardButton(f"⚔️ +3 к Атаке клика ({next_price_dmg} монет)", callback_data="buy_dmg"),
            types.InlineKeyboardButton(f"❤️ +100 к Макс. HP ({next_price_hp} монет)", callback_data="buy_hp")
        )

        new_balance = users_data[username]["coins"]
        bot.edit_message_text(
            chat_id=chat_id,
            message_id=call.message.message_id,
            text=f"🛒 *МАГАЗИН УЛУЧШЕНИЙ ПОКЕМОНА*\n\n💰 Твой баланс: {new_balance} монет(ы)\nВыбери параметр для прокачки:",
            reply_markup=updated_markup,
            parse_mode="Markdown"
        )
        bot.answer_callback_query(call.id)
    except Exception:
        bot.answer_callback_query(call.id)


