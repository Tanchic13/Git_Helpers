@bot.callback_query_handler(func=lambda call: call.data.startswith("select_"))
def handle_player_selection(call):
    target_username = call.data.split("_")[1]
    challenger_id = call.from_user.id
    search_sessions[challenger_id] = target_username

    bot.edit_message_text(
        chat_id=call.message.chat.id,
        message_id=call.message.message_id,
        text=f" Вы выбрали игрока *{target_username}*.\n\nТеперь создайте комнату через режим с другом и **отправьте в этот чат её ID код (цифры)**:",
        parse_mode="Markdown"
    )
    bot.register_next_step_handler(call.message, process_room_id)


def process_room_id(message):
    challenger_id = message.from_user.id
    room_id = message.text.strip()

    if challenger_id not in search_sessions:
        return

    target_username = search_sessions[challenger_id]
    challenger_name = message.from_user.username or message.from_user.first_name
    del search_sessions[challenger_id]

    # Безопасно достаем chat_id соперника из структуры
    target_chat_id = None
    if target_username in users_data and isinstance(users_data[target_username], dict):
        target_chat_id = users_data[target_username].get("chat_id")

    if target_chat_id:
        try:
            bot.send_message(
                target_chat_id,
                f"⚔️ *Хочешь со мной поиграть в битву? Тогда присоединяйся!*\n\n"
                f"Игрок *@{challenger_name}* вызывает тебя на бой!\n"
                f"Для входа введите команду:\n`/join {room_id}`",
                parse_mode="Markdown"
            )
            bot.reply_to(message, f"✅ Приглашение отправлено игроку *{target_username}* с кодом `{room_id}`!")
        except Exception:
            bot.reply_to(message, f"❌ Не удалось отправить сообщение игроку *{target_username}*.")
    else:
        bot.reply_to(message, f"❌ У игрока *{target_username}* не найден `chat_id`. Ему нужно написать боту команду `/start`.")



