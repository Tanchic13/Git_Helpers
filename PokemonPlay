    )

    if dmg1 > dmg2:
        users_data[p1]["coins"] += 250
        if not users_data[p1]["quests"]["wins"]["done"]:
            users_data[p1]["quests"]["wins"]["current"] += 1
        bot.send_message(battle["p1_chat"], res_text + "🏆 Вы победили друга и получили 250 монет!", parse_mode="Markdown")
        bot.send_message(battle["p2_chat"], res_text + "😢 Вы проиграли дуэль.", parse_mode="Markdown")
    elif dmg2 > dmg1:
        users_data[p2]["coins"] += 250
        if not users_data[p2]["quests"]["wins"]["done"]:
            users_data[p2]["quests"]["wins"]["current"] += 1
        bot.send_message(battle["p2_chat"], res_text + "🏆 Вы победили друга и получили 250 монет!", parse_mode="Markdown")
        bot.send_message(battle["p1_chat"], res_text + "😢 Вы проиграли дуэль.", parse_mode="Markdown")
    else:
        bot.send_message(battle["p1_chat"], res_text + "🤝 Ничья! Оба игрока кликали одинаково.", parse_mode="Markdown")
        bot.send_message(battle["p2_chat"], res_text + "🤝 Ничья! Оба игрока кликали одинаково.", parse_mode="Markdown")

    if battle_id in active_battles:
        del active_battles[battle_id]



