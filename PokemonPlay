@bot.callback_query_handler(func=lambda call: call.data.startswith("mode_") or call.data.startswith("click_"))
def handle_callbacks(call):
    username = call.from_user.username or call.from_user.first_name
    chat_id = call.message.chat.id
    msg_id = call.message.message_id

    if "quests" in users_data[username] and not users_data[username]["quests"]["clicks"]["done"]:
                          users_data[username]["quests"]["clicks"]["current"] += 1

    # --- Нажата кнопка: Бой с Роботом ---
    if call.data == "mode_bot":
        try:
            bot.edit_message_reply_markup(chat_id, msg_id, reply_markup=None)
        except Exception:
            pass

        my_pokemon = users_data[username]["pokemon"]
        enemy_name = random.choice(RANDOM_POKEMONS)
        enemy_pokemon = Pokemon(enemy_name)

        battle_id = f"bot_{username}_{int(time.time())}"
        active_battles[battle_id] = {
            "type": "bot",
            "p1": username,
            "p1_chat": chat_id,
            "p1_clicks": 0,
            "bot_clicks": 0,
            "is_active": True
        }

        # Запускаем таймер боя в отдельном потоке
        threading.Thread(target=start_countdown_bot, args=(chat_id, battle_id, my_pokemon, enemy_pokemon), daemon=True).start()

    # --- Нажата кнопка: Бой с Другом (Создание комнаты) ---
    elif call.data == "mode_friend":
        try:
            bot.edit_message_reply_markup(chat_id, msg_id, reply_markup=None)
        except Exception:
            pass

        lobby_id = str(random.randint(1000, 9999))
        active_lobbies[lobby_id] = {
            "player1": username,
            "player1_chat": chat_id,
            "player2": None,
            "player2_chat": None
        }

        bot.send_message(
            chat_id,
            f"🏰 *Вечеринка создана!*\n\nПерешли другу этот секретный код: `{lobby_id}`\n\n"
            f"Чтобы подключиться к тебе, твой друг должен отправить боту сообщение: `join {lobby_id}`",
            parse_mode="Markdown"
        )

    # --- Нажата игровая кнопка кликера ---
    elif call.data.startswith("click_"):
        battle_id = call.data.replace("click_", "")

        if battle_id in active_battles:
            battle = active_battles[battle_id]
            if not battle["is_active"]:
                bot.answer_callback_query(call.id, "⏱ Время раунда уже вышло!")
                return

            # Засчитываем клик для одиночного боя
            if battle["type"] == "bot" and battle["p1"] == username:
                battle["p1_clicks"] += 1
                if "quests" in users_data[username] and not users_data[username]["quests"]["clicks"]["done"]:
                    users_data[username]["quests"]["clicks"]["current"] += 1
                bot.answer_callback_query(call.id, f"⚡ Нажатие засчитано! Всего: {battle['p1_clicks']}")

            # Засчитываем клик для ПвП боя
            elif battle["type"] == "friend":
                if battle["p1"] == username:
                    battle["p1_clicks"] += 1
                    if not users_data[username]["quests"]["clicks"]["done"]:
                        users_data[username]["quests"]["clicks"]["current"] += 1
                    bot.answer_callback_query(call.id, f"⚡ Твой клик засчитан! Всего: {battle['p1_clicks']}")
                elif battle["p2"] == username:
                    battle["p2_clicks"] += 1
                    if not users_data[username]["quests"]["done"]:
                        users_data[username]["quests"]["clicks"]["current"] += 1
                    bot.answer_callback_query(call.id, f"⚡ Твой клик засчитан! Всего: {battle['p2_clicks']}")


@bot.message_handler(func=lambda msg: msg.text and msg.text.lower().startswith("join "))
def join_lobby(message):
    username = message.from_user.username or message.from_user.first_name
    chat_id = message.chat.id

    if username not in users_data:
        bot.reply_to(message, "❌ У вас нет покемона! Сначала создайте его командой /go")
        return

    # Извлекаем ID комнаты из текста сообщения
    try:
        lobby_id = message.text.split(" ")[1].strip()
    except IndexError:
        bot.reply_to(message, "❌ Укажите код комнаты. Пример: `join 1234`")
        return

    if lobby_id in active_lobbies:
        lobby = active_lobbies[lobby_id]

        if lobby["player1"] == username:
            bot.reply_to(message, "⚠️ Вы не можете играть сами с собой!")
            return

        lobby["player2"] = username
        lobby["player2_chat"] = chat_id

        # Создаем сессию активного сражения двух игроков
        battle_id = f"pvp_{lobby_id}"
        active_battles[battle_id] = {
            "type": "friend",
            "p1": lobby["player1"],
            "p1_chat": lobby["player1_chat"],
            "p2": lobby["player2"],
            "p2_chat": lobby["player2_chat"],
            "p1_clicks": 0,
            "p2_clicks": 0,
            "is_active": True
        }

    # Оповещаем обоих оппонентов
        bot.send_message(lobby["player1_chat"], f"⚔️ Игрок @{username} подключился к комнате! Приготовиться...")
        bot.send_message(chat_id, f"⚔️ Вы успешно подключились к @{lobby['player1']}! Приготовиться...")

        p1_poke = users_data[lobby["player1"]]["pokemon"]
        p2_poke = users_data[username]["pokemon"]

        # Удаляем комнату из списка ожидания и запускаем таймер дуэли
        del active_lobbies[lobby_id]
        threading.Thread(target=start_countdown_friend, args=(battle_id, p1_poke, p2_poke), daemon=True).start()
    else:
        bot.reply_to(message, "❌ Комната с таким кодом не найдена или игра уже началась.")

