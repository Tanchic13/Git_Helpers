    msg2 = bot.send_message(battle["p2_chat"], "⚔️ *БОЙ НАЧАЛСЯ! КЛИКАЙ!* \n⏱ Осталось: 20 сек", reply_markup=markup, parse_mode="Markdown")

    for t in range(19, -1, -1):
        time.sleep(1)
        try:
            bot.edit_message_text(f"⚔️ *КЛИК-БИТВА С ДРУГОМ!* \n⏱ Осталось: {t} сек", battle["p1_chat"], msg1.message_id, reply_markup=markup, parse_mode="Markdown")
            bot.edit_message_text(f"⚔️ *КЛИК-БИТВА С ДРУГОМ!* \n⏱ Осталось: {t} сек", battle["p2_chat"], msg2.message_id, reply_markup=markup, parse_mode="Markdown")
        except Exception:
