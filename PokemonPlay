# 6. ФУНКЦИИ ТАЙМЕРОВ И ПОДВЕДЕНИЯ ИТОГОВ
# =====================================================================
def start_countdown_bot(chat_id, battle_id, my_pokemon, enemy_pokemon):
    my_pokemon.hp = my_pokemon.max_hp

    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("💥 КЛИКАТЬ ТУТ КАК МОЖНО БЫСТРЕЕ! 💥", callback_data=f"click_{battle_id}"))

    msg = bot.send_message(
        chat_id,
        f"⚔️ *БОЙ НАЧАЛСЯ!*\n\nБыстро-быстро нажимай на кнопку ниже!\n⏱ Осталось времени: 20 сек",
        reply_markup=markup,
        parse_mode="Markdown"
    )

    for t in range(19, -1, -1):
        time.sleep(1)
        try:
            bot.edit_message_text(
                f"⚔️ *БОЙ В САМОМ РАЗГАРЕ!*\n\nБыстро-быстро кликай на кнопку!\n⏱ Осталось времени: {t} сек",
                chat_id, msg.message_id, reply_markup=markup, parse_mode="Markdown"
            )
        except Exception:
            pass

    try:
        bot.edit_message_text("⏱ *ВРЕМЯ ВЫШЛО!* Считаем твои клики...", chat_id, msg.message_id, reply_markup=None, parse_mode="Markdown")
    except Exception:
        pass

    time.sleep(1)

    battle = active_battles.get(battle_id)
    if not battle:
        return

    battle["is_active"] = False

    user_clicks = battle.get("p1_clicks", 0)
    bot_clicks = random.randint(8, 50)

    user_damage = user_clicks * my_pokemon.attack
    bot_damage = bot_clicks * enemy_pokemon.attack

    enemy_pokemon.hp -= user_damage
    my_pokemon.hp -= bot_damage

    result_text = (
        f"📊 *ИТОГИ КЛИК-РАУНДА:*\n\n"
        f"👤 Ты накликал: *{user_clicks}* раз (Урон: {user_damage})\n"
        f"🤖 Робот накликал: *{bot_clicks}* раз (Урон: {bot_damage})\n\n"
        f"🛸 Твой {my_pokemon.name}: ({max(0, my_pokemon.hp)}/{my_pokemon.max_hp}) HP\n"
        f"🤖 Робот {enemy_pokemon.name}: ({max(0, enemy_pokemon.hp)}/{enemy_pokemon.max_hp}) HP\n\n"
    )

    username = battle["p1"]
    if user_damage > bot_damage:
        coins = random.randint(25, 100)
        users_data[username]["coins"] += coins
        result_text += f"🏆 *ПОБЕДА!* Твои пальцы быстрее процессора! Ты разнес Робота!\n💰 Награда: +{coins} монет."
        if not users_data[username]["quests"]["wins"]["done"]:
            users_data[username]["quests"]["wins"]["current"] += 1
    elif user_damage < bot_damage:
        result_text += "👻 *ПОРАЖЕНИЕ!* Робот кликал быстрее тебя. Разминай пальцы к следующему разу!"
    else:
        result_text += "🤝 *НИЧЬЯ!* Вы кликали с абсолютно одинаковой скоростью!"

    bot.send_message(chat_id, result_text, parse_mode="Markdown")
    if battle_id in active_battles:
        del active_battles[battle_id]

def start_countdown_friend(battle_id, p1_poke, p2_poke):
    battle = active_battles[battle_id]
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("💥 ЖМИ СЮДА! 💥", callback_data=f"click_{battle_id}"))

