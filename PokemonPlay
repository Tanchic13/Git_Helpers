        self.name = name
        self.level = 1.0
        self.max_hp = random.randint(115, 350)  # Большой запас здоровья для кликера
        self.hp = self.max_hp
        self.attack = random.randint(8, 14)    # Сколько урона наносит один клик

    def info(self):
        return f"👾 Покемон: {self.name}\n⭐ Уровень: {self.level}\n❤️ Здоровье: {self.hp}/{self.max_hp}\n⚔️ Сила клика: {self.attack}"

