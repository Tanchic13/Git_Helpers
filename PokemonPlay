# 1. ФУНКЦИИ РАСЧЕТА ЦЕН (теперь работают через счетчик покупок в профиле)
def get_dmg_price(username):
    # Если счетчика покупок нет в базе, он считается равным 0
    upgrades_count = users_data[username].get('dmg_upgrades', 0)

    base_price = 25 + (upgrades_count * 50)
    multiplier = 1 + (upgrades_count // 3)  # Каждые 3 покупки цена удваивается
    return base_price * multiplier

def get_hp_price(username):
    upgrades_count = users_data[username].get('hp_upgrades', 0)

    base_price = 45 + (upgrades_count * 50)
    multiplier = 1 + (upgrades_count // 3)  # Каждые 3 покупки цена удваивается
    return base_price * multiplier


