    try:
        bot.edit_message_text("⏱ Время вышло! Считаем результаты дуэли...", battle["p1_chat"], msg1.message_id, reply_markup=None)
        bot.edit_message_text("⏱ Время вышло! Считаем результаты дуэли...", battle["p2_chat"], msg2.message_id, reply_markup=None)
    except Exception:
        pass

    time.sleep(1)

    p1, p2 = battle["p1"], battle["p2"]
    clicks1, clicks2 = battle["p1_clicks"], battle["p2_clicks"]
    dmg1, dmg2 = clicks1 * p1_poke.attack, clicks2 * p2_poke.attack

    res_text = (
        f"👑 *РЕЗУЛЬТАТЫ ДУЭЛИ ДРУЗЕЙ:*\n\n"
