def run_and_print_cool(title, query, headers):
    print(f"\n🔥 {title.upper()} 🔥")
    print("=" * 70)
    header_format = "".join([f"{{:<{w}}}" for w in headers.values()])
    print(header_format.format(*headers.keys()))
    print("-" * 70)
    
    cursor.execute(query)
    rows = cursor.fetchall()
    for row in rows:
        formatted_row = []
        for val in row:
            if isinstance(val, int) and val > 1000:
                formatted_row.append(f"{val:,}".replace(",", " "))
            else:
                formatted_row.append(str(val))
        print(header_format.format(*formatted_row))
    print("=" * 70)


run_and_print_cool(
    "1. Последний релиз каждого мастера", 
    """SELECT d.name, MAX(m.release_date) FROM directors d 
       INNER JOIN movies m ON d.id = m.director_id GROUP BY d.id, d.name""",
    {"ИМЯ РЕЖИССЕРА": 28, "ПОСЛЕДНИЙ ВЫПУСК": 20}
)

