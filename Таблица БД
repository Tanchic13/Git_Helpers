import sqlite3

# 1. Подключение к базе данных (файл создастся автоматически)
conn = sqlite3.connect('rutube_database.db')
cursor = conn.cursor()

# 2. Создание таблицы RuTube (без поля description)
cursor.execute('''
CREATE TABLE IF NOT EXISTS RuTube (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    url TEXT NOT NULL,
    author TEXT,
    release_date TEXT
)
''')
conn.commit()
print("Таблица RuTube успешно создана.\n")

# 3. Добавление минимум 5 строк в таблицу
videos_data = [
    ('Изучаем Python за 1 час', 'https://rutube.ru', 'Прогер', '2025-01-10'),
    ('Основы SQLite для новичков', 'https://rutube.ru', 'БазыДанныхТВ', '2025-02-15'),
    ('Как создать свой сайт', 'https://rutube.ru', 'ВебМастер', '2026-03-20'),
    ('Обзор новинок нейросетей', 'https://rutube.ru', 'ИИ Техно', '2026-05-12'),
    ('Секреты чистого кода', 'https://rutube.ru', 'КодГру', '2026-08-01')
]

cursor.executemany('''
INSERT INTO RuTube (title, url, author, release_date)
VALUES (?, ?, ?, ?)
''', videos_data)
conn.commit()
print("5 записей успешно добавлены.\n")

# 4. Вывод всех данных из таблицы
print("=== ВСЕ ЗАПИСИ В ТАБЛИЦЕ ===")
cursor.execute("SELECT * FROM RuTube")
rows = cursor.fetchall()
for row in rows:
    print(row)
print("\n")

# 5. Изменение одной записи с помощью UPDATE
cursor.execute('''
UPDATE RuTube 
SET title = 'Супер-интенсив по Python' 
WHERE id = 1
''')
conn.commit()
print("Запись с id=1 обновлена.\n")

# 6. Удаление одной записи с помощью DELETE
cursor.execute('''
DELETE FROM RuTube 
WHERE id = 5
''')
conn.commit()
print("Запись с id=5 удалена.\n")

# Проверка итогового состояния таблицы
print("=== ИТОГОВАЯ ТАБЛИЦА ПОСЛЕ ИЗМЕНЕНИЙ ===")
cursor.execute("SELECT * FROM RuTube")
for row in cursor.fetchall():
    print(row)

# Закрытие соединения
conn.close()
